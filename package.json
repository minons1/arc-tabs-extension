{
  "name": "arc-tabs",
  "version": "0.2.0",
  "description": "Auto-close inactive tabs after 12 hours — like Arc browser",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "clean": "rm -rf dist",
    "bump": "node scripts/bump.mjs",
    "bump:p": "node scripts/bump.mjs p",
    "bump:mi": "node scripts/bump.mjs mi",
    "bump:ma": "node scripts/bump.mjs ma"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.3.0"
  }
}
